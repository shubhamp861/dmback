# Template only: deliberately invalid placeholders, never real secrets.
# Use your deployment's private secret manager/environment, not committed .env files.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://APP_USER:REPLACE_WITH_PASSWORD@POSTGRES_HOST/app
REDIS_URL=rediss://APP_USER:REPLACE_WITH_PASSWORD@REDIS_HOST:6380/0
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-real-meta-app-secret
META_REDIRECT_URI=https://API_HOST/v1/auth/instagram/callback
# Pin the version verified against Meta documentation for your app.
META_API_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.instagram.com
META_OAUTH_BASE_URL=https://api.instagram.com
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
META_WEBHOOK_VERIFY_TOKEN=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-canonical-base64-encoded-32-byte-key
WEB_ORIGIN=https://WEB_HOST
LOG_LEVEL=info
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=30000
# Tune these in the deployment secret/environment configuration.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_WEBHOOK_IP_MAX=120
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_WORKSPACE_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# AES-GCM is still a development foundation, not production KMS/rotation support.
# Validate provider-specific PostgreSQL TLS settings before deployment.
