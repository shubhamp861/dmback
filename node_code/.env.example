NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://instagram:instagram@localhost:5432/instagram_automation
REDIS_URL=redis://localhost:6379
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
# Instagram business login only accepts HTTPS redirect URIs, so real Meta
# credentials need a tunnel: register https://<tunnel-host>/v1/auth/instagram/relay
# in the dashboard and set the same value here. See
# devResource/META-INTEGRATION-CONTRACT.md.
META_REDIRECT_URI=http://localhost:3000/v1/auth/instagram/callback
META_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.instagram.com
META_OAUTH_BASE_URL=https://api.instagram.com
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Optional Google Identity Services web client ID. When empty, Google sign-in is
# disabled and the frontend shows a configuration hint. Create a "Web application"
# OAuth client ID at https://console.cloud.google.com/apis/credentials with the
# authorized JavaScript origin http://localhost:3001. No client secret is used.
GOOGLE_CLIENT_ID=471270319835-j0lqu6vh4us83d1otuq6c9a2dephar09.apps.googleusercontent.com
WEB_ORIGIN=http://localhost:3001
LOG_LEVEL=info
# Optional deadlines in milliseconds (defaults shown)
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=30000
# Optional Redis-backed request limits (defaults shown; RATE_LIMIT_ENABLED defaults true)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_WEBHOOK_IP_MAX=120
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_WORKSPACE_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Optional idempotency retention (defaults shown); the worker deletes completed
# records after this many hours and stuck in-progress records after 60 minutes.
IDEMPOTENCY_RETENTION_HOURS=24
