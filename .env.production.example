# Copy to .env.production and replace every placeholder before deployment.
# This file is a template only; do not commit .env.production.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# These values configure the native production deployment's PostgreSQL and Redis connections.
POSTGRES_DB=instagram_automation
POSTGRES_USER=instagram
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# Point these at the production PostgreSQL and Redis endpoints.
DATABASE_URL=postgresql://instagram:replace-with-a-long-random-postgres-password@postgres:5432/instagram_automation
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0

META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-at-least-32-random-characters
META_REDIRECT_URI=https://YOUR_PUBLIC_HOST/v1/auth/instagram/callback
META_API_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.instagram.com
META_OAUTH_BASE_URL=https://api.instagram.com
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
META_WEBHOOK_VERIFY_TOKEN=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-canonical-base64-encoded-32-byte-key

# Same-origin production serving: the browser loads the UI and /v1 API from this origin.
WEB_ORIGIN=https://YOUR_PUBLIC_HOST
LOG_LEVEL=info
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=30000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_WEBHOOK_IP_MAX=120
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_WORKSPACE_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# Optional host binding for the API server.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
